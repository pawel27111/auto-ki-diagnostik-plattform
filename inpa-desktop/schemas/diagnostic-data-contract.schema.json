{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:inpa-ai:diagnostic-data-contract:1.0",
  "title": "INPA AI neutral diagnostic data contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "dataMode",
    "vehicleProfile",
    "ecu",
    "job",
    "capturedAtUtc",
    "durationMs",
    "values",
    "missingFields",
    "errors",
    "runtimeVerified"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "dataMode": {
      "enum": ["SYNTHETIC", "LIVE"]
    },
    "vehicleProfile": {
      "type": "string",
      "minLength": 1
    },
    "ecu": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": ["string", "null"]
    },
    "capturedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "values": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnosticValue"
      }
    },
    "missingFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtimeVerified": {
      "type": "boolean"
    },
    "fixture": {
      "$ref": "#/definitions/fixtureMetadata"
    }
  },
  "definitions": {
    "diagnosticValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawFieldName",
        "normalizedName",
        "value",
        "unit",
        "validity",
        "sourceJob",
        "mappingStatus"
      ],
      "properties": {
        "rawFieldName": {
          "type": "string",
          "minLength": 1
        },
        "normalizedName": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "validity": {
          "enum": ["valid", "synthetic", "not-present", "invalid"]
        },
        "sourceJob": {
          "type": "string",
          "minLength": 1
        },
        "mappingStatus": {
          "enum": ["mapped", "unmapped"]
        }
      }
    },
    "fixtureMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "disclaimer"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataMode": {
            "const": "SYNTHETIC"
          }
        }
      },
      "then": {
        "properties": {
          "runtimeVerified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataMode": {
            "const": "LIVE"
          }
        }
      },
      "then": {
        "properties": {
          "runtimeVerified": {
            "const": true
          }
        }
      }
    }
  ]
}
