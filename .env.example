# ─────────────────────────────────────────────────────────────────────────────
# AutoKI Assistent — configuration
#
# Copy to .env and fill in. The server validates the required block on startup
# and refuses to boot with a clear message if something is missing, rather than
# failing later on the first login.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Signs the session cookie. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session.
JWT_SECRET=

# MySQL 8.0 or newer (the migrations use REGEXP_REPLACE).
DATABASE_URL=mysql://user:password@localhost:3306/autoki

# OAuth client id for this deployment.
# Not needed when DEV_AUTH_ENABLED=true (see below).
VITE_APP_ID=

# Base URL of the OAuth server used for the token exchange.
# Not needed when DEV_AUTH_ENABLED=true (see below).
OAUTH_SERVER_URL=

# ── Local development login ──────────────────────────────────────────────────
#
# Sign-in normally goes through the external OAuth server above. A local
# checkout has no credentials for it, which leaves no way to get a session and
# therefore no way to try the app out at all.
#
# With this set, /api/oauth/login issues a session for a fixed local user
# instead of redirecting to the OAuth portal, and VITE_APP_ID and
# OAUTH_SERVER_URL are no longer required to boot.
#
# ANYONE who can reach the server can then sign in without credentials. It is
# for local testing only: the server refuses to start if this is combined with
# NODE_ENV=production.
DEV_AUTH_ENABLED=

# Identity of the local test user. The defaults are fine.
DEV_AUTH_OPEN_ID=dev-user
DEV_AUTH_NAME=Entwickler
DEV_AUTH_EMAIL=dev@localhost

# ── Optional ─────────────────────────────────────────────────────────────────

# HTTP port. The server picks the next free port if this one is taken.
PORT=3000

# openId of the account that should be promoted to admin on first sign-in.
OWNER_OPEN_ID=

# Portal the login redirect points at. Falls back to OAUTH_SERVER_URL.
VITE_OAUTH_PORTAL_URL=

# Extra origins allowed to open a WebSocket connection and to send mutating
# requests, comma separated. Leave empty for same-origin only — that is the
# right value for a single-domain deployment.
#   ALLOWED_ORIGINS=https://autoki.example.com,https://app.example.com
ALLOWED_ORIGINS=

# ── OBD hardware ─────────────────────────────────────────────────────────────

# Serial ports the server may open, comma separated. The port to connect to
# arrives from the browser, so this allow list is what stops a client from
# naming an arbitrary device file on the host. Empty disables hardware access
# entirely; the simulator still works.
#   Linux:   /dev/ttyUSB0,/dev/ttyACM0
#   macOS:   /dev/tty.usbserial-1420
#   Windows: COM3,COM4
OBD_ALLOWED_PORTS=

# ── AI analysis (optional) ───────────────────────────────────────────────────
#
# Without a provider the app falls back to a small built-in catalogue of common
# trouble codes. Nothing breaks; the analyses are just generic.

# auto (default) prefers LM Studio when configured, otherwise OpenRouter.
LLM_PROVIDER=auto

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Local LM Studio. Vehicle data never leaves the machine with this option.
#   LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_BASE_URL=
LMSTUDIO_MODEL=local-model

# Analyses per user per hour.
LLM_RATE_LIMIT_PER_HOUR=60

# ── Platform storage (optional) ──────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
